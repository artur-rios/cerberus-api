# Line endings are LF in the repository and in the working tree, on every
# platform, as .editorconfig's `end_of_line = lf` wants. The index already
# stores every text file outside .superpowers/ with LF, so this codifies what
# is there rather than changing it: `git add --renormalize .` changes nothing.
#
# It also makes a Windows clone with `core.autocrlf=true` check out LF, so the
# local `dotnet format --verify-no-changes` sees what CI sees.
* text=auto eol=lf

# Scripts, where the ending is part of the contract with the interpreter: a
# CRLF shell script fails in a Linux container or on the CI agent.
*.sh        text eol=lf

# Agent checkpoints are an archive kept byte for byte. 13 of their Markdown
# files are stored with CRLF; normalizing them would rewrite history's copies,
# so nothing under .superpowers/ is converted either way.
.superpowers/** -text

# Binaries: never converted, never diffed as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.dll    binary
*.so     binary
*.dylib  binary
*.exe    binary
*.pdb    binary
*.snk    binary
*.nupkg  binary
