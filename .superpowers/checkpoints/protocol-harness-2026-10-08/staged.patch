+def benchmark(samples):
+    import platform
+    import time
+    import cryptography
+    from .primitives import argon2
+    if type(samples) is not int or not 1 <= samples <= 1000: raise ValueError()
+    password, salt = b'public benchmark fixture', bytes(range(16))
+    argon2(password, salt)
+    times=[]
