+    [FunctionalFact]
+    public async Task GivenPreviousMigrationWithNativeContent_WhenUpgrading_ThenPreserveRowsAndEnforceNewMemberships()
+    {
+        // This database belongs only to this test; the shared fixture database is untouched.
