+            {
+                if(await db.Database.ExecuteSqlInterpolatedAsync($"""
+                    UPDATE cerberus.folder SET revision=revision+1,server_sequence=nextval('cerberus.server_sequence'),concurrency_stamp={Guid.NewGuid()}
