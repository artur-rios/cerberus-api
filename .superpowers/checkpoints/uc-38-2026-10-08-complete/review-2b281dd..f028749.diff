+        var result = await new InitializeVaultHandler(new InitializeVaultValidator(),store.Object).HandleAsync(Init(client.Material));
+        Assert.Contains("persistence_unavailable",result.Errors); Assert.Null(result.Data);
+    }
+
+    [UnitTheory]
